# ==============================================================================
# Muddy Server Environment Configuration
# ==============================================================================

# Server & Network
APP_NAME="Muddy Server"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# Feature Flags (Enable/Disable Subsystems to Control RAM & Compute)
# ------------------------------------------------------------------------------
ENABLE_LLM_GATEWAY=true
ENABLE_AGENTS=true
ENABLE_DOCS_ENGINE=true
ENABLE_WEBSOCKETS=true
ENABLE_SQL_DB=true

# Heavy Compute Flags (Disabled by default: Zero RAM/Process Overhead)
ENABLE_ML_TRANSFORMERS=false
ENABLE_RAY_COMPUTE=false
ENABLE_REDIS_QUEUE=false

# ------------------------------------------------------------------------------
# AI & LLM Providers (Configure at least one for live execution)
# ------------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER="gemini"

# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Local / Ollama
LOCAL_LLM_BASE_URL="http://localhost:11434/v1"
LOCAL_LLM_MODEL="llama3.2:1b"

# ------------------------------------------------------------------------------
# SQL Database (SQLite for Dev, PostgreSQL for Production)
# ------------------------------------------------------------------------------
DATABASE_URL="sqlite+aiosqlite:///muddy_server.db"
DB_ECHO=false

# ------------------------------------------------------------------------------
# Redis & Distributed Queue (Active if ENABLE_REDIS_QUEUE=true)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"
QUEUE_NAME="muddy_compute_queue"

# ------------------------------------------------------------------------------
# Ray Cluster (Active if ENABLE_RAY_COMPUTE=true)
# ------------------------------------------------------------------------------
RAY_ADDRESS=""
RAY_INCLUDE_DASHBOARD=false
