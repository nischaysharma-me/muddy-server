		{
			"name": "Compute & Background Jobs",
			"item": [
				{
					"name": "Submit Compute Job",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 202) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.job_id) {",
									"        pm.environment.set(\"job_id\", jsonData.job_id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"job_type\": \"article_generation\",\n  \"payload\": {\n    \"topic\": \"Event-Driven Microservices with LangGraph and FastAPI\",\n    \"target_audience\": \"Senior Backend Architects\",\n    \"model\": \"gemini-3.7-flash\"\n  },\n  \"run_async\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/compute/jobs",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "compute", "jobs"]
						},
						"description": "Submits an asynchronous compute job. Returns job_id and WebSocket streaming URL in < 5ms."
					},
					"response": []
				},
				{
					"name": "Get Compute Job Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/compute/jobs/{{job_id}}",
