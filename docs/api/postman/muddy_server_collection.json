							"path": ["api", "v1", "compute", "jobs", "{{job_id}}"]
						},
						"description": "Retrieves live execution status, 0-100% progress, stage, execution time, and JSON outputs."
					},
					"response": []
				},
				{
					"name": "Cancel Compute Job",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/compute/jobs/{{job_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "compute", "jobs", "{{job_id}}"]
						},
						"description": "Cancels a queued or executing compute job."
					},
					"response": []
				},
